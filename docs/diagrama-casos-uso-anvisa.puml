@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam actorStyle stick
skinparam packageStyle rectangle
skinparam dpi 200

actor "Analista" as Analista
actor "Agendador" as Agendador

rectangle "ANVISA" {
  usecase "HU20 – Consultar produtos ANVISA" as Produtos
  usecase "HU21 – Atualizar base ANVISA" as Atualizar
}

Analista -- Produtos
Analista -- Atualizar
Agendador -- Atualizar
@enduml
