@startuml
!theme plain
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam participantBackgroundColor white
skinparam ArrowColor black
skinparam SequenceLifeLineBorderColor #888888
skinparam shadowing false
skinparam dpi 200
skinparam sequenceMessageAlign center
hide footbox

actor "Analista" as U
boundary "marcas.xhtml" as V
control "MarcaBean" as B
participant "MarcaService" as S
participant "MarcaDao" as DAO
database "PostgreSQL" as DB

U -> V : clica em "Incluir Marca" ou "Editar"
V -> B : novo() / editar(id)
B --> V : abre o formulário
U -> V : preenche os dados e clica em "Salvar"
V -> B : salvar()
B -> S : salvar(entidade)
S -> S : valida o nome e padroniza\nem maiúsculas
S -> DAO : buscarPorNome(nome)
DAO -> DB : SELECT marca
alt não há duplicidade
  S -> DAO : salvar(entidade)
  DAO -> DB : INSERT/UPDATE marca\n(revisão de auditoria)
  B --> V : fecha o formulário e atualiza a lista
else registro duplicado
  S --> B : DuplicateRecordException
  B --> V : mensagem de erro
end
V --> U : resultado
@enduml
