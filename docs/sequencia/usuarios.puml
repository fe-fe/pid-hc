@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 200
skinparam sequenceMessageAlign center
hide footbox

actor "Administrador" as U
boundary "users.xhtml" as V
control "UsuarioBean" as B
participant "UsuarioService" as S
participant "UsuarioDao" as DAO
database "PostgreSQL" as DB

U -> V : clica em "Novo usuário" ou "Editar"
V -> B : novo() / editar(id)
B --> V : abre o formulário
U -> V : preenche os dados e clica em "Salvar"
V -> B : salvar()
B -> S : salvar(usuario)
S -> S : valida campos obrigatórios,\ne-mail e CPF únicos e senha
S -> S : impede desativar ou rebaixar\no último administrador ativo
alt dados válidos
  S -> DAO : salvar(usuario)
  DAO -> DB : INSERT/UPDATE usuario\n(revisão de auditoria)
  B --> V : fecha o formulário e atualiza a lista
else regra violada
  S --> B : DomainException
  B --> V : mensagem de erro
end
V --> U : resultado
@enduml
