@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 200
skinparam sequenceMessageAlign center
hide footbox

actor "Analista" as U
boundary "fabricantes.xhtml" as V
control "FabricanteBean" as B
participant "FabricanteService" as S
participant "FabricanteDao" as DAO
database "PostgreSQL" as DB

U -> V : clica em "Incluir Fabricante" ou "Editar"
V -> B : novo() / editar(id)
B --> V : abre o formulário
U -> V : preenche os dados e clica em "Salvar"
V -> B : salvar()
B -> S : salvar(entidade)
S -> S : valida o nome e padroniza\nem maiúsculas
S -> DAO : buscarPorNome(nome)
DAO -> DB : SELECT fabricante
alt não há duplicidade
  S -> DAO : salvar(entidade)
  DAO -> DB : INSERT/UPDATE fabricante\n(revisão de auditoria)
  B --> V : fecha o formulário e atualiza a lista
else registro duplicado
  S --> B : DuplicateRecordException
  B --> V : mensagem de erro
end
V --> U : resultado
@enduml
