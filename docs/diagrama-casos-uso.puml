@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam actorStyle stick
skinparam packageStyle rectangle
skinparam dpi 200

actor "Analista" as Analista
actor "Administrador" as Admin
actor "Agendador" as Agendador

Admin --|> Analista

rectangle "Módulo PID" {
  package "Acesso" {
    usecase "HU01 – Fazer login" as Login
    usecase "HU02 – Encerrar sessão" as Sair
    usecase "HU03 – Realizar primeiro acesso" as PrimeiroAcesso
  }
  package "Usuários e auditoria" {
    usecase "HU04 – Gerenciar usuários" as Usuarios
    usecase "HU05 – Atribuir perfil de acesso" as Perfil
    usecase "HU06 – Consultar auditoria" as Auditoria
  }
  package "Cadastros" {
    usecase "HU07 – Gerenciar materiais" as Materiais
    usecase "HU08 – Gerenciar fabricantes" as Fabricantes
    usecase "HU09 – Gerenciar marcas" as Marcas
  }
  package "Avaliação" {
    usecase "HU10 – Registrar avaliação técnica" as Registrar
    usecase "HU11 – Consultar avaliações" as Avaliacoes
    usecase "HU12 – Editar avaliação" as EditarAvaliacao
    usecase "HU13 – Sugerir fabricante e marca\npelo registro ANVISA" as Sugerir
  }
  package "Consultas de material" {
    usecase "HU14 – Visualizar dashboard" as Dashboard
    usecase "HU15 – Consultar histórico do material" as Historico
  }
  package "Tecnovigilância" {
    usecase "HU16 – Consultar desvios de qualidade" as Desvios
    usecase "HU17 – Editar desvio de qualidade" as EditarDesvio
    usecase "HU18 – Importar planilha de tecnovigilância" as Importar
    usecase "HU19 – Baixar modelo da planilha" as Modelo
  }
  package "ANVISA" {
    usecase "HU20 – Consultar produtos ANVISA" as Produtos
    usecase "HU21 – Atualizar base ANVISA" as AtualizarAnvisa
  }
}

Analista -- Login
Analista -- Sair
Analista -- Materiais
Analista -- Fabricantes
Analista -- Marcas
Analista -- Registrar
Analista -- Avaliacoes
Analista -- Dashboard
Analista -- Historico
Analista -- Desvios
Analista -- Importar
Analista -- Modelo
Analista -- Produtos
Analista -- AtualizarAnvisa

Admin -- PrimeiroAcesso
Admin -- Usuarios
Admin -- Auditoria

Agendador -- AtualizarAnvisa

Usuarios ..> Perfil : <<include>>
Avaliacoes <.. EditarAvaliacao : <<extend>>
Registrar <.. Sugerir : <<extend>>
EditarAvaliacao <.. Sugerir : <<extend>>
Desvios <.. EditarDesvio : <<extend>>

@enduml
