@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam actorStyle stick
skinparam packageStyle rectangle
skinparam dpi 200

actor "Analista" as Analista
actor "Administrador" as Admin

Admin --|> Analista

rectangle "Acesso" {
  usecase "HU01 – Fazer login" as Login
  usecase "HU02 – Encerrar sessão" as Sair
  usecase "HU03 – Realizar primeiro acesso" as PrimeiroAcesso
}

Analista -- Login
Analista -- Sair
Admin -- PrimeiroAcesso
@enduml
